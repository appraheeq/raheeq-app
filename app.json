{
  "expo": {
    "name": "رحيق | Raheeq",
    "slug": "raheeqapp",
    "owner": "raheeqapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./PngLogo/logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAF8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raheeq.app"
    },
    "android": {
      "package": "com.raheeq.app",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#127019"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./icon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Araboto-Normal.ttf",
            "./assets/fonts/Araboto-Medium.ttf",
            "./assets/fonts/Araboto-Bold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f9fc0133-f69a-446a-a57b-d3280b8a8205"
      }
    }
  }
}
